PORT=3001
HOST=127.0.0.1
DATABASE_PATH=.data/mise.sqlite
USDA_API_KEY=
ANDROID_PACKAGE_NAME=com.mise.macroarchitect
GOOGLE_PLAY_PRODUCT_ID=mise_pro
# Set GOOGLE_APPLICATION_CREDENTIALS to the local service account file; never commit it.
GOOGLE_APPLICATION_CREDENTIALS=
# Generate keys with: npm exec tsx src/keys.ts (from apps/api).
ENTITLEMENT_PRIVATE_KEY=
PURCHASE_ENCRYPTION_KEY=
# Pub/Sub push audience and service-account email must match the configured subscription.
RTDN_AUDIENCE=
RTDN_SERVICE_ACCOUNT=
# Comma-separated browser origins; leave empty for native-only clients.
CORS_ORIGINS=http://localhost:8081
