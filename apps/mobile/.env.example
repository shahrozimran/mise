# Android emulator reaches a local API via http://10.0.2.2:3001.
# A physical device needs your computer's LAN address or an HTTPS deployment.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_ENTITLEMENT_KEY=
EXPO_PUBLIC_GOOGLE_PLAY_PRODUCT_ID=mise_pro
# Development builds only: preview Pro tools without creating a paid entitlement.
EXPO_PUBLIC_PRO_PREVIEW=false
