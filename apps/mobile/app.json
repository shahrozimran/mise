{
  "expo": {
    "name": "Mise · Macro Architect",
    "slug": "mise-macro-architect",
    "scheme": "mise",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/mise-icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F8F6F1",
    "primaryColor": "#252422",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mise.macroarchitect",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "resize",
      "allowBackup": false,
      "blockedPermissions": ["android.permission.RECORD_AUDIO", "android.permission.READ_EXTERNAL_STORAGE", "android.permission.WRITE_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "backgroundColor": "#252422",
        "foregroundImage": "./assets/mise-foreground.png",
        "monochromeImage": "./assets/mise-foreground.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/mise-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-sqlite",
      "expo-sharing",
      "expo-secure-store",
      "expo-iap",
      ["expo-camera", { "recordAudioAndroid": false, "barcodeScannerEnabled": true }],
      "./plugins/withWindowsCMakePaths"
    ]
  }
}
